{
  "name": "huagongmumian-ios-pwa",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "pwa.10273055.xyz", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
