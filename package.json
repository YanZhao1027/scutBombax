{
  "name": "scut-bombax",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-privacy.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dom": "node scripts/check-dom.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:privacy:selftest": "node scripts/check-privacy.mjs --selftest",
    "hooks:install": "./scripts/install-hooks.sh",
    "check:env": "./scripts/check-env.sh",
    "android": "pnpm build && cap sync android",
    "apk": "cd android && ../scripts/with-jdk.sh ./gradlew assembleDebug",
    "apk:release": "pnpm android && cd android && ../scripts/with-jdk.sh ./gradlew assembleRelease",
    "native:test": "cd android && ../scripts/with-jdk.sh ./gradlew testDebugUnitTest",
    "install:device": "${ANDROID_HOME:-$HOME/Android/Sdk}/platform-tools/adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
