# Copy to android/keystore.properties (gitignored) and fill in. Never commit the real file,
# and never commit the .jks — .gitignore already refuses both.
#
# Generate a key once, and back the file up somewhere you trust more than this laptop:
#
#   keytool -genkeypair -v \
#     -keystore android/bombax.jks -alias bombax -keyalg RSA -keysize 2048 -validity 10000
#
# Losing this key does not lose the app, it loses the *update path*: an APK signed with a
# different key cannot replace an installed one, so the user has to uninstall (which wipes the
# Keystore-encrypted session and re-log in) before the new build can be installed.
#
# Relative paths here are resolved against the android/ directory. Environment variables of the
# same name in BOMBAX_KEYSTORE_* form win over this file, so a one-off build can sign without
# writing a password to disk.

storeFile=bombax.jks
storePassword=
keyAlias=bombax
keyPassword=
